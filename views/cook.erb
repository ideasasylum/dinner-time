<%# locals: (plan:, placed:, devices:, last_alert:) %>
<% first = Schedule.first_start(placed) %>
<header class="bar">
  <a class="back" href="/" aria-label="All plans"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
  <h1><%= plan["name"] %></h1>
  <details class="menu">
    <summary aria-label="Cooking options"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="2" fill="currentColor"/><circle cx="12" cy="12" r="2" fill="currentColor"/><circle cx="19" cy="12" r="2" fill="currentColor"/></svg></summary>
    <div class="sheet">
      <p class="sheet-title">Running late? Move serving time</p>
      <div class="row">
        <% [-15, -5, 5, 15].each do |m| %>
          <form method="post" action="/plans/<%= plan["id"] %>/shift"><%= csrf_field %><input type="hidden" name="minutes" value="<%= m %>"><button class="btn small"><%= m > 0 ? "+#{m}" : m %> min</button></form>
        <% end %>
      </div>
      <form method="post" action="/plans/<%= plan["id"] %>/reset"><%= csrf_field %><button class="btn">Untick everything</button></form>
      <button class="btn" type="button" data-wake>Keep screen on</button>
      <button class="btn" type="button" data-notify data-label="Allow alerts">Allow alerts</button>
      <p class="sheet-note" data-notify-status><%= devices.zero? ? "No device gets phone alerts yet. Tap Allow alerts." : "#{devices} device#{devices == 1 ? "" : "s"} get#{devices == 1 ? "s" : ""} phone alerts." %><% unless last_alert.empty? %> Last one: <%= last_alert.split("\n").first %>.<% end %></p>
    </div>
  </details>
</header>

<main class="cook" id="cook" data-plan="<%= plan["id"] %>" data-serve="<%= plan["serve_at"] %>" data-tz="<%= plan["tz_offset"] %>">
  <% pending = placed.find { |s| s["done_at"].nil? } %>
  <section class="clock" data-state="<%= pending.nil? ? "done" : "next" %>">
    <div class="banner-head">
      <span class="banner-label" data-label><%= pending.nil? ? "Done" : "Next" %></span>
      <span class="banner-dish" data-dish><%= pending.nil? ? "" : pending["dish"] %></span>
      <span class="banner-count"><strong data-count>&#8212;</strong><small data-unit><%= pending.nil? ? "" : "to go" %></small></span>
    </div>
    <div class="banner-line">
      <p class="banner-name" data-headline aria-live="polite"><%= pending.nil? ? "Everything is done" : pending["name"] %></p>
      <button class="btn primary banner-start" type="button" data-start-focus hidden>Start</button>
    </div>
    <p class="banner-foot">
      <span data-next></span>
      <span class="serve">Serve <%= hhmm(plan["serve_at"], plan) %></span>
    </p>
    <p class="cooking-strip" data-cooking hidden></p>
    <p class="behind" data-behind hidden>
      <span data-behind-text></span>
      <button class="btn small" type="button" data-catch-up></button>
    </p>
    <span class="banner-bar" data-progress></span>
  </section>

  <% if placed.empty? %>
    <p class="board-empty">Nothing to cook yet. Add some steps on the Steps tab.</p>
  <% end %>

  <ol class="timeline">
    <% placed.each do |s| %>
      <li class="tl-step <%= s["done_at"].nil? ? "" : "done" %>"
          data-step="<%= s["id"] %>" data-start="<%= s["start_at"] %>" data-end="<%= s["end_at"] %>" data-name="<%= s["name"] %>" data-dish="<%= s["dish"] %>" data-place="<%= place_label(s["place"].to_s) %>" data-hands="<%= s["hands"].to_i %>"
          data-minutes="<%= s["minutes"].to_i %>" data-started="<%= s["started_at"] %>">
        <label class="dep">
          <input type="checkbox" class="tick" <%= s["done_at"].nil? ? "" : "checked" %> aria-label="Done: <%= s["name"] %>">
          <span class="t"><%= hhmm(s["start_at"], plan) %></span>
          <span class="main">
            <span class="name"><%= s["name"] %></span>
            <span class="cap">
              <span><%= s["dish"] %></span>
              <% if s["place"].to_s != "" %><span class="platform"><%= place_label(s["place"].to_s) %></span><% end %>
              <% if s["hands"].to_i == 1 %><span class="platform hands">Hands-on</span><% end %>
              <% if s["minutes"].to_i > 0 %><span><%= Clock.duration(s["minutes"].to_i) %> · until <%= hhmm(s["end_at"], plan) %></span><% end %>
              <% if s["shifted"].to_i == 1 %><span class="tag" title="Moved earlier so your hands are free">Moved earlier</span><% end %>
            </span>
            <span class="countdown" data-countdown></span>
          </span>
          <span class="lamp-wrap" aria-hidden="true">
            <svg class="lamp" viewBox="0 0 24 24"><circle class="glow" cx="12" cy="12" r="12"/><circle class="ring" cx="12" cy="12" r="7"/><circle class="core" cx="12" cy="12" r="3.5"/><circle class="dot" cx="12" cy="12" r="8"/><path class="tick" d="M8.2 12.2 10.8 14.8 15.8 9.4"/></svg>
            <span class="state" data-state><%= s["done_at"].nil? ? "Waiting" : "Done" %></span>
          </span>
        </label>
      </li>
    <% end %>
    <li class="tl-step serve">
      <div class="dep">
        <span class="t"><%= hhmm(plan["serve_at"], plan) %></span>
        <span class="main"><span class="name">Dinner is served</span></span>
      </div>
    </li>
  </ol>
</main>

<nav class="tabs">
  <a href="/plans/<%= plan["id"] %>">Steps</a>
  <a class="on" href="/plans/<%= plan["id"] %>/cook">Cook</a>
</nav>
